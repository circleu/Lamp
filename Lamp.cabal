cabal-version:      3.0
name:               Lamp
version:            0.1.0.0
-- synopsis:
-- description:
license:            MIT
license-file:       LICENSE
author:             circleu
maintainer:         shawndev25@gmail.com
-- copyright:
category:           Development
build-type:         Simple
extra-doc-files:    CHANGELOG.md
extra-source-files: c-source/*

common warnings
